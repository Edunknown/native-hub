{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NATIVE HUB",
  "version": "0.3.0",
  "identifier": "dev.nativehub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NATIVE HUB",
        "width": 1360,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "create": false,
        "minWidth": 960,
        "minHeight": 640,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: cover: http://cover.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMUIzQkRFODI3OTI2QjgKUldTNEpubUMzanNiT3lURnA4SCtoS1E0VURqQnYxWnV1T28vRzlvTkxpdzU1KzluVXB2RTloVWMK",
      "endpoints": [
        "https://github.com/Edunknown/native-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
