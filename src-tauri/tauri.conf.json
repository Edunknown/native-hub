{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "NATIVE HUB",
    "version":  "0.1.0",
    "identifier":  "dev.nativehub.app",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "NATIVE HUB",
                                    "width":  1360,
                                    "height":  860,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "label":  "main",
                                    "minWidth":  960,
                                    "minHeight":  640
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 data: https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ipc: http://ipc.localhost"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
